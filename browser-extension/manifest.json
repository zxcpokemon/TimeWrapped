{
  "manifest_version": 3,
  "name": "TimeWrapped",
  "version": "1.1.0",
  "description": "Одно дополнение: активные сайты, SoundCloud и настройки музыки. Данные остаются на вашем ПК.",
  "permissions": [
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:38671/*",
    "https://soundcloud.com/*",
    "https://www.soundcloud.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://soundcloud.com/*",
        "https://www.soundcloud.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "TimeWrapped — сайты и музыка",
    "default_popup": "popup.html"
  },
  "optional_permissions": [
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "incognito": "not_allowed",
  "key": "",
  "icons": {
    "128": "icon.png"
  },
  "minimum_chrome_version": "120"
}
