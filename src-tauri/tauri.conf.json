{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeWrapped",
  "version": "0.3.0",
  "identifier": "app.timewrapped.desktop",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "TimeWrapped", "width": 1280, "height": 850, "minWidth": 940, "minHeight": 650, "center": true, "backgroundColor": "#0c0e13", "theme": "Dark" }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'" }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Локальная статистика экранного времени и итоги недели",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }, "nsis": { "installMode": "currentUser", "languages": ["Russian", "English"], "displayLanguageSelector": true, "installerHooks": "installer-hooks.nsh" } }
  }
}
